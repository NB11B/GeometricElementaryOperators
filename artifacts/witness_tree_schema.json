{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Geometric Elementary Operator Witness Tree",
  "type": "object",
  "required": ["terminal_count", "root", "nodes"],
  "properties": {
    "name": {"type": "string"},
    "target_id": {"type": "integer", "minimum": 1, "maximum": 36},
    "terminal_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "root": {"type": "integer", "minimum": 0},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["kind", "terminal_index"],
            "properties": {
              "kind": {"const": "terminal"},
              "terminal_index": {"type": "integer", "minimum": 0, "maximum": 255}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["kind", "left", "right", "lanes"],
            "properties": {
              "kind": {"const": "omega"},
              "left": {"type": "integer", "minimum": 0},
              "right": {"type": "integer", "minimum": 0},
              "lanes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["scalar", "geometric"]}
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "description": "Nodes are topologically ordered. Every omega node references only earlier nodes. Terminals map to preloaded registers; omega results are allocated consecutively."
}
